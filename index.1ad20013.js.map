"use strict";
var galleryList = document.getElementById("thumbs");
galleryList.addEventListener("click", function(ev) {
    ev.preventDefault();
    var link = ev.target.closest("a");
    if (!link) return;
    var bigImgURL = link.href;
    document.getElementById("largeImg").src = bigImgURL;
});

